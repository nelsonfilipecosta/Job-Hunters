# Copy to `.env` and fill in real values.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = sk-ant-...

# Signs the "Applied" / "Dismiss" links in the digest so they cannot be forged.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it invalidates every link already sitting in your inbox.
ACTION_TOKEN_SECRET =

# Where the daily digest is sent, and the address it is sent from. These are
# not credentials, but they identify you, so they live here rather than in
# `config/system_config.yaml`, which this repository tracks. DIGEST_FROM
# defaults to DIGEST_TO when left blank.
DIGEST_TO =
DIGEST_FROM =

# The account SMTP_PASSWORD belongs to. For Gmail this is the full address.
# Leave it blank and it defaults to DIGEST_FROM and then to DIGEST_TO, which for
# a Gmail account is normally the same string three times over.
SMTP_USERNAME =

# For Gmail this is an App Password (16 characters, no spaces), NOT your normal
# account password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD =
